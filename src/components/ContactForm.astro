<section
  id="ecrire"
  class="page-block"
  aria-labelledby="contact-form-heading"
  data-component="contact.form"
>
  <p class="note">Écrire au cabinet</p>
  <h2 id="contact-form-heading">Envoyer un message</h2>
  <p>
    Une réponse vous est apportée rapidement, généralement sous 24 à 48 heures ouvrées.
  </p>

  <p id="contact-sent" hidden role="status">Merci : votre message a bien été envoyé.</p>
  <p id="contact-error" hidden role="alert">
    L’envoi n’a pas abouti. Réessayez dans un instant, ou écrivez directement par e-mail.
  </p>
  <script is:inline>
    const sent = new URLSearchParams(location.search).get("sent");
    const status = document.getElementById(sent === "1" ? "contact-sent" : sent === "0" ? "contact-error" : "");
    if (status) status.hidden = false;
  </script>

  <form class="space-y-5" method="POST" action="/api/contact">

    <p class="sr-only" aria-hidden="true">
      <label>
        Ne pas remplir ce champ
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
      </label>
    </p>

    <div class="grid gap-4 md:grid-cols-2">
      <div>
        <label for="contact-name">
          Nom <span aria-hidden="true">*</span>
        </label>
        <input
          id="contact-name"
          name="name"
          type="text"
          required
          autocomplete="name"
          class="form-field"
        />
      </div>

      <div>
        <label for="contact-email">
          E-mail <span aria-hidden="true">*</span>
        </label>
        <input
          id="contact-email"
          name="email"
          type="email"
          required
          autocomplete="email"
          class="form-field"
        />
      </div>
    </div>

    <div>
      <label for="contact-phone">Téléphone</label>
      <input id="contact-phone" name="phone" type="tel" autocomplete="tel" class="form-field" />
    </div>

    <div>
      <label for="contact-message">
        Message <span aria-hidden="true">*</span>
      </label>
      <textarea id="contact-message" name="message" required rows={6} class="form-field"></textarea>
      <p class="form-hint">Les champs marqués d’un * sont obligatoires.</p>
    </div>

    <p class="form-hint">Vos informations restent confidentielles et ne sont jamais partagées.</p>
    <button type="submit" class="cta-primary"> Envoyer le message </button>
  </form>
</section>
