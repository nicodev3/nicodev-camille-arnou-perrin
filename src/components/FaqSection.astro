---
import { ChevronDown } from "@lucide/astro";
import { client } from "../lib/client";
import { resolvedFaqEntries } from "../lib/client/faqPresets.ts";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const items = resolvedFaqEntries(client.profession);
const faqJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: items.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
}).replace(/</g, "\\u003c");
---

<section class:list={["page-block", className]} data-component="panel.faq">
  <h2>Questions fréquentes</h2>
  <div>
    {items.map((item) => (
      <details data-component="faq.item">
        <summary>
          <>
            <span>{item.question}</span>
            <ChevronDown size={20} aria-hidden="true" />
          </>
        </summary>
        <p>{item.answer}</p>
      </details>
    ))}
  </div>
</section>

<script is:inline type="application/ld+json" set:html={faqJsonLd} />
