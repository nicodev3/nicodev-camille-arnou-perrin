---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { client } from "../lib/client";

/* Photo pro : `src/assets/photos/camille-perrin-2.jpeg`. Absent → placeholder. */
const portraitGlob = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/photos/camille-perrin-2.jpeg",
  {
    eager: true,
  },
);
const photo = Object.values(portraitGlob)[0]?.default ?? null;

interface Props {
  class?: string;
}

const { class: figureClass } = Astro.props;

/*
 * Cadrage : le conteneur est carré mais la photo est verticale. Le recadrage est laissé au CSS
 * (`object-top`) plutôt qu'à la génération d'image, qui découperait depuis le centre et couperait
 * le haut de la tête.
 */
---

<figure class={figureClass} data-component="ui.practitioner-portrait">
  <div class="aspect-square overflow-hidden">
    {
      photo ? (
        <Image
          src={photo}
          alt={`${client.business.fullName}, ${client.business.title}`}
          class="h-full w-full object-cover object-top"
          widths={[480, 720, 960]}
          sizes="(max-width: 768px) 92vw, 360px"
          quality={85}
        />
      ) : (
        <div class="flex h-full min-h-64 w-full items-center justify-center p-6 text-center text-sm">
          Photo du praticien
        </div>
      )
    }
  </div>
</figure>
