---
import CredentialsPanel from "../CredentialsPanel.astro";
import PractitionerPortrait from "../PractitionerPortrait.astro";
import ProjectSection from "../ProjectSection.astro";
import { client } from "../../lib/client";

const sidebarSummary = client.aboutPage.sidebarSummary ?? "";
const introParagraphs = client.aboutPage.intro
  .split(/\n{2,}/)
  .map((paragraph) => paragraph.trim())
  .filter(Boolean);
---

<header
  class="page-block flex flex-col gap-6 md:flex-row md:items-start"
  data-component="about.intro"
>
  <PractitionerPortrait class="mx-auto w-full max-w-xs shrink-0 md:mx-0 md:max-w-sm" />
  <div class="min-w-0 flex-1 space-y-2">
    <h1>{client.business.fullName}</h1>
    {sidebarSummary && <p class="note">{sidebarSummary}</p>}
    {introParagraphs.map((paragraph) => <p class="lead">{paragraph}</p>)}
  </div>
</header>

<ProjectSection class="my-10" headingLevel={2} />

<CredentialsPanel />
