---
import ContactCard from "../ContactCard.astro";
import ContactHoursBlock from "../ContactHoursBlock.astro";
import ContactForm from "../ContactForm.astro";
import FaqSection from "../FaqSection.astro";
import { enabledContactHoursRows } from "../../lib/client/contactHours";
import { client } from "../../lib/client";

const hasHours = enabledContactHoursRows(client.contact.hours).length > 0;
const hasForm = client.contact.channels.selected.includes("form");
const waitingListNote = client.practice.waitingListNote ?? "";
---

<section class="page-block" data-component="contact.info">
  <ContactCard />
</section>

{
  waitingListNote && !hasHours && (
    <section class="page-block" data-component="contact.waiting">
      <p>{waitingListNote}</p>
    </section>
  )
}

{
  (hasForm || hasHours) && (
    <section
      class:list={["grid gap-6", hasForm && hasHours && "lg:grid-cols-5"]}
    >
      {hasForm && (
        <div class:list={["min-w-0", hasHours && "lg:col-span-3"]}>
          <ContactForm />
        </div>
      )}
      {hasHours && (
        <div class:list={["min-w-0", hasForm && "lg:col-span-2"]} data-component="contact.hours">
          <ContactHoursBlock />
          {waitingListNote && <p>{waitingListNote}</p>}
        </div>
      )}
    </section>
  )
}

<FaqSection />
