---
import MotifsOpenInvitation from "../MotifsOpenInvitation.astro";
import { client } from "../../lib/client";
import { slugify } from "../../lib/slugify";

interface Props {
  /** Page listant le détail des motifs. */
  detailsPageHref?: string;
}

const { detailsPageHref = "/pourquoi-consulter/" } = Astro.props;
const specialtyLabels = client.practice.specialties;
---

<section class="space-y-10" data-component="section.services">
  <h2>Motifs de consultation</h2>
  {specialtyLabels.length > 0 && (
    <>
      <ul>
        {specialtyLabels.map((label) => (
          <li>
            {label}
            <a
              class="motif-card-link"
              href={`${detailsPageHref}#${slugify(label)}`}
              aria-label={`Découvrir l'accompagnement — ${label}`}
            ></a>
          </li>
        ))}
      </ul>
      <MotifsOpenInvitation headingLevel={3} />
      <div class="pt-3">
        <a href={detailsPageHref} class="cta-secondary cta-secondary--sm">
          Pourquoi consulter ? — Voir tous les motifs
        </a>
      </div>
    </>
  )}
</section>
