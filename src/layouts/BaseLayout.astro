---
import "../styles/global.css";
import "../styles/stitch.css";
import { Font } from "astro:assets";
import { PUBLIC_NOINDEX } from "astro:env/client";
import { siteFontCssVariables } from "../design/font-css-variables.mjs";
import { client } from "../lib/client";
import { NON_INDEXABLE_PATHS } from "../lib/non-indexable-paths.mjs";
import { professionMainEntityJsonLdType } from "../lib/client/professionCopy.ts";
import { businessAreaLocalities, businessStreetLines } from "../lib/client/businessAddress";
import { enabledContactHoursRows } from "../lib/client/contactHours";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  isNotFound?: boolean;
}

const {
  title = client.seo.siteName,
  description = client.seo.description,
  isNotFound = false,
} = Astro.props;

const pageUrl = new URL(Astro.url.pathname, Astro.site);
const noindex =
  isNotFound ||
  PUBLIC_NOINDEX ||
  NON_INDEXABLE_PATHS.some(
    (path) => Astro.url.pathname === path.slice(0, -1) || Astro.url.pathname.startsWith(path),
  );
const mainEntityLdType = professionMainEntityJsonLdType(client.profession);
const fontVariables = Object.values(siteFontCssVariables);

const practitionerId = new URL("#practitioner", Astro.site).href;
const cabinetId = new URL("#cabinet", Astro.site).href;
const postalAddressJsonLd = {
  "@type": "PostalAddress",
  streetAddress: businessStreetLines(client.business).join(", "),
  postalCode: client.business.postalCode,
  addressLocality: client.business.city,
  addressCountry: "FR",
};

const SCHEMA_ORG_WEEKDAY = {
  monday: "Monday",
  tuesday: "Tuesday",
  wednesday: "Wednesday",
  thursday: "Thursday",
  friday: "Friday",
  saturday: "Saturday",
  sunday: "Sunday",
} as const;

/** « 10h00 - 20h00 » → { opens: "10:00", closes: "20:00" } ; null si le format est inattendu. */
function parseHoursRange(value: string): { opens: string; closes: string } | null {
  const match = value.match(/(\d{1,2})\s*h\s*(\d{2})?\s*[-–à]+\s*(\d{1,2})\s*h\s*(\d{2})?/i);
  if (!match) return null;
  const hhmm = (h: string, m?: string) => `${h.padStart(2, "0")}:${m ?? "00"}`;
  return { opens: hhmm(match[1]!, match[2]), closes: hhmm(match[3]!, match[4]) };
}

const openingHoursSpecification = enabledContactHoursRows(client.contact.hours).flatMap(
  (row) => {
    const range = parseHoursRange(row.value);
    return range
      ? [{ "@type": "OpeningHoursSpecification", dayOfWeek: SCHEMA_ORG_WEEKDAY[row.day], ...range }]
      : [];
  },
);

const mainEntityJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": mainEntityLdType,
      "@id": practitionerId,
      name: client.business.fullName,
      sameAs: client.social.links
        .filter((link) => link.label === "LinkedIn perso")
        .map((link) => link.href),
      ...(mainEntityLdType === "Person" ? { jobTitle: client.business.title } : {}),
      description: client.seo.description,
      url: Astro.site,
      telephone: client.business.phone,
      email: client.business.email,
      workLocation: { "@id": cabinetId },
      address: postalAddressJsonLd,
    },
    {
      // MedicalBusiness est un sous-type de LocalBusiness : le cabinet devient une entité locale.
      "@type": "MedicalBusiness",
      "@id": cabinetId,
      name: "Cabinet de Camille Perrin — Centre Via Sana Rive Droite",
      url: Astro.site,
      description: client.seo.description,
      image: client.seo.ogImage,
      telephone: client.business.phone,
      email: client.business.email,
      hasMap: "https://www.google.com/maps?cid=946393530713656690",
      geo: { "@type": "GeoCoordinates", latitude: 48.814545, longitude: 2.135884 },
      address: postalAddressJsonLd,
      areaServed: businessAreaLocalities(client.business).map((name) => ({
        "@type": "City",
        name,
      })),
      ...(openingHoursSpecification.length > 0 ? { openingHoursSpecification } : {}),
      employee: { "@id": practitionerId },
    },
  ],
});
---

<html lang="fr" data-component="layout.base">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!isNotFound && <link rel="canonical" href={pageUrl} />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content={client.seo.siteName} />
    <meta property="og:image" content={client.seo.ogImage} />
    {fontVariables.map((cssVariable) => (
      <Font cssVariable={cssVariable as never} preload />
    ))}
    <script
      is:inline
      type="application/ld+json"
      set:html={mainEntityJsonLd.replace(/</g, "\\u003c")}
    />
    {!isNotFound && (
      <script
        is:inline
        defer
        src="https://analytics.nicodev.fr/script.js"
        data-website-id="20dcd773-f6b9-4180-872e-abcf9f1617f6"
        data-performance="true"
      ></script>
    )}
  </head>

  <body class="min-h-screen">
    <a class="skip-link" href="#contenu">
      Aller au contenu
    </a>
    <slot />
    <Footer />
  </body>
</html>
