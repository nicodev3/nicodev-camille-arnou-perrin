---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
---

<BaseLayout
  title="Page introuvable | Camille Perrin"
  description="Cette page n’existe pas ou a été déplacée. Retrouvez les informations du cabinet depuis l’accueil."
  isNotFound
>
  <Header />
  <main id="contenu" tabindex="-1" class="site-container page" data-component="page">
    <header class="page-header">
      <p>Erreur 404</p>
      <h1>Page introuvable</h1>
      <p class="lead">Cette page n’existe pas ou a été déplacée.</p>
    </header>
    <div class="page-content">
      <p>
        <a href="/">Revenir à l’accueil</a>
      </p>
    </div>
  </main>
</BaseLayout>
